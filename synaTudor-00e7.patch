     return true;
 }
 
+bool tudor_unpair(struct tudor_device *device) {
+    /* The WBIO sensor adapter's ControlUnit has a hardcoded allowlist of
+     * IOCTL codes (0x440020, 0x440024, 0x44240C, 0x442410, 0x442480) and
+     * rejects anything else with E_INVALIDARG — so 0x442040 (ResetOwnership)
+     * can't reach the WUDF driver through that path. Instead, dispatch
+     * directly via winwdf_devctrl_file, which mirrors what wbiosrvc.exe
+     * would do on Windows: open the WDF device file and send the raw IOCTL.
+     * Lands at synaEvtIoDeviceControl -> CBiometricDevice::OnResetOwnership
+     * -> DoUnpairing. */
+
+    /* WINBIO_IDENTITY as input — type WILDCARD means "any user". */
+    WINBIO_IDENTITY ident = {0};
+    ident.Type = WINBIO_ID_TYPE_WILDCARD;
+    ident.Wildcard = 0;
+
+    UCHAR recv_buf[256] = {0};
+
+    log_info("WBIO unpair | direct WDF dispatch of IOCTL 0x442040 with WINBIO_IDENTITY (WILDCARD)...");
+
+    /* Match the same module/threading dance tudor_devctrl uses for normal
+     * pipeline IOCTLs (see lines ~38 of device.c). */
+    winmodule_set_cur(&tudor_driver_dll->module);
+
+    struct winwdf_request *req = NULL;
+    NTSTATUS status = winwdf_devctrl_file(device->wdf_file, 0x442040,
+        &ident, sizeof(ident),
+        recv_buf, sizeof(recv_buf),
+        &req);
+    log_info("WBIO unpair | initial winwdf_devctrl_file status=0x%x req=%p", (unsigned) status, (void *) req);
+
+    if(status != STATUS_SUCCESS) return false;
+
+    /* Drive the WDF event queue so the IOCTL dispatcher actually runs. */
+    winwdf_event_queue_flush();
+
+    /* Now read out the request result. */
+    if(req) {
+        NTSTATUS req_status = STATUS_PENDING;
+        const void *in_buf = NULL, *out_buf = NULL;
+        size_t in_size = 0, out_size = 0;
+        ULONG_PTR drv_info = 0;
+        winwdf_get_request_info(req, &req_status, &in_buf, &in_size, &out_buf, &out_size, &drv_info);
+        log_info("WBIO unpair | req_status=0x%x bytes_transferred=%zu out_buf=%p out_size=%zu",
+            (unsigned) req_status, (size_t) drv_info, out_buf, out_size);
+        return req_status == STATUS_SUCCESS;
+    }
+    return false;
+}
+
+bool tudor_pair(struct tudor_device *device) {
+    /* IOCTL 0x44002C → synaEvtIoDeviceControl dispatch arm at VA 0x18001e5e7
+     * → CBiometricDevice::OnConnectSecure at VA 0x18001de08. When the host
+     * has no pairing data, OnConnectSecure triggers the pairing handshake
+     * (which in turn calls DoPairing internally). After unpair via 0x442040,
+     * the next "Need to perform pairing" failure is expected to be resolved
+     * by this IOCTL. */
+
+    WINBIO_IDENTITY ident = {0};
+    ident.Type = WINBIO_ID_TYPE_WILDCARD;
+    ident.Wildcard = 0;
+
+    UCHAR recv_buf[256] = {0};
+
+    log_info("WBIO pair | direct WDF dispatch of IOCTL 0x44002C (OnConnectSecure)...");
+    winmodule_set_cur(&tudor_driver_dll->module);
+
+    struct winwdf_request *req = NULL;
+    NTSTATUS status = winwdf_devctrl_file(device->wdf_file, 0x44002C,
+        &ident, sizeof(ident),
+        recv_buf, sizeof(recv_buf),
+        &req);
+    log_info("WBIO pair | initial winwdf_devctrl_file status=0x%x req=%p", (unsigned) status, (void *) req);
+
+    if(status != STATUS_SUCCESS) return false;
+
+    winwdf_event_queue_flush();
+
+    if(req) {
+        NTSTATUS req_status = STATUS_PENDING;
+        const void *in_buf = NULL, *out_buf = NULL;
+        size_t in_size = 0, out_size = 0;
+        ULONG_PTR drv_info = 0;
+        winwdf_get_request_info(req, &req_status, &in_buf, &in_size, &out_buf, &out_size, &drv_info);
+        log_info("WBIO pair | req_status=0x%x bytes_transferred=%zu out_buf=%p out_size=%zu",
+            (unsigned) req_status, (size_t) drv_info, out_buf, out_size);
+        return req_status == STATUS_SUCCESS;
+    }
+    return false;
+}
+
 bool tudor_close(struct tudor_device *device) {
     HRESULT hres;
 
