+ * observable on subsequent operations. */
+bool tudor_unpair(struct tudor_device *device);
+
+/* IOCTL 0x44002C → CBiometricDevice::OnConnectSecure, which on this DLL
+ * triggers the pair flow when no pairing data is present on the host. */
